{
  "name": "kirora-expo-example",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prebuild": "expo prebuild --clean",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas-build-pre-install": "./scripts/eas-pre-install.sh",
    "vendor-sdk": "rm -f vendor/*.tgz && (cd ../../kirora-react-native && npm pack --pack-destination ../kirora-expo-plugin/example/vendor) && mv vendor/kirora-react-native-*.tgz vendor/kirora-react-native.tgz && npm install --legacy-peer-deps @kirora/react-native@file:vendor/kirora-react-native.tgz"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@kirora/expo-plugin": "file:..",
    "@kirora/react-native": "file:vendor/kirora-react-native.tgz",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
