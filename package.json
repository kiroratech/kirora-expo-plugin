{
  "name": "@kirora/expo-plugin",
  "version": "0.1.0",
  "description": "Expo config plugin for @kirora/react-native: push setup on Android and iOS, applied on every prebuild.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiroratech/kirora-expo-plugin.git"
  },
  "homepage": "https://github.com/kiroratech/kirora-expo-plugin#readme",
  "bugs": "https://github.com/kiroratech/kirora-expo-plugin/issues",
  "files": [
    "build",
    "app.plugin.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "expo",
    "config-plugin",
    "kirora",
    "react-native",
    "push-notifications"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"build-test/**/*.test.js\"",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@kirora/react-native": ">=0.1.0",
    "expo": ">=53.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "expo": "~58.0.26",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
